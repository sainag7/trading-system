# =============================================================================
# Environment variables for the swing-trading system.
# Copy this file to `.env` and fill in your own values:  cp .env.example .env
# `.env` is gitignored — never commit real keys.
# =============================================================================

# --- Claude Agent SDK / Anthropic API -------------------------------------
# Required to run the LLM agents (research / analysis / decision / monitor).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Market data ----------------------------------------------------------
# Alpha Vantage free tier = 25 requests/day. Get a free key at:
#   https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here

# FRED (macro data: rates, CPI, etc.). Optional. Free key at:
#   https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key_here

# --- Robinhood Trading MCP -------------------------------------------------
# The Robinhood Trading MCP uses OAuth handled by the MCP server itself.
# Do NOT put a Robinhood password or API secret here. The only thing you may
# need is the MCP endpoint (already defaulted in config.yaml) and, optionally,
# a pre-obtained OAuth bearer token if you are not doing the interactive flow.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
# ROBINHOOD_MCP_TOKEN=        # optional: only if using a non-interactive token

# --- Misc -----------------------------------------------------------------
# Override the run mode without editing config.yaml (paper|preview|live).
# CLI flag --mode still takes precedence over this.
# TRADING_MODE=paper
